# Secrets — never commit
.env
.env.*
!.env.example

# Per-agent state (SSH keys, metadata, VM logs, Firefox profiles)
logs/

# Local Claude Code settings
.claude/

# macOS
.DS_Store

# Python bytecode
__pycache__/
*.pyc
# The desktop gateway's packages for its check (test.sh uses it)
desktop-gateway/.venv/

# Built before each image build (vm_guide_build)
packer/.vm-agent-guide.md

# Editor swap / scratch
*.swp
*.tmp

# Real pipeline output: snapshots, transcripts, API results. Never commit these.
dashboard/*.json
*.jsonl

# Talk decks and exported chats sit in the tree but are not part of the tool.
talk/
Claude outputs/
*.pptx

# Operator-only data: Jira emails.
reporters.tsv

# Dashboard v2: npm packages and test output. The build in dashboard-v2/dist is committed.
node_modules/
dashboard-v2/test-results/
dashboard-v2/playwright-report/
